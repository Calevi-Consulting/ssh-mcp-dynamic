  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calevi-Consulting/ssh-mcp-dynamic.git"
  },
  "homepage": "https://github.com/Calevi-Consulting/ssh-mcp-dynamic#readme",
  "bugs": {
